# Line endings are normalised to LF in the repository and in the working tree.
# Without this, checking out on Windows rewrites every file to CRLF and the whole
# tree shows as modified on a machine that uses LF.
* text=auto eol=lf

# Windows-only scripts have to keep CRLF or they will not run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diffed, never normalised.
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.zip  binary
*.woff binary
*.woff2 binary

# Generated: collapse in pull request diffs.
bun.lock          linguist-generated=true
package-lock.json linguist-generated=true
